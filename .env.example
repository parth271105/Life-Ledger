# Neon "Pooled connection" string, plus connect_timeout=15 (helps Neon cold starts)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Same string without "-pooler" (used only by `prisma db push`)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# openssl rand -base64 32
AUTH_SECRET=""
# Any long random string; Vercel Cron sends it automatically
CRON_SECRET=""
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
